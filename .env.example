# The read-only source. Set this to the same VAULT_HOST_PATH used by
# obsidian-headless-sync-docker.
VAULT_HOST_PATH=../obsidian-headless-sync-docker/vault

# Persistent Git repository and generated SSH identity.
BACKUP_DATA_PATH=./data

# Create an empty Gitea repository first. Do not initialize it with a README.
GIT_REMOTE_URL=git@gitea.example.com:your-user/obsidian-backup.git
GIT_BRANCH=main
GIT_AUTHOR_NAME=Obsidian Backup
GIT_AUTHOR_EMAIL=obsidian-backup@example.com

# Wait for two quiet minutes after the last filesystem event. Under continuous
# activity, take a snapshot at least every 15 minutes. Also rescan periodically
# in case the host/filesystem does not deliver an inotify event.
DEBOUNCE_SECONDS=120
MAX_WAIT_SECONDS=900
RESCAN_SECONDS=300

# Push retry behavior. A failed push is retried without making duplicate commits.
PUSH_RETRIES=5
PUSH_RETRY_SECONDS=30

# The key is generated automatically in BACKUP_DATA_PATH/ssh on first start.
SSH_KEY_TYPE=ed25519
SSH_KEY_COMMENT=obsidian-git-backup

# Recommended: pin the Gitea SSH host key. This accepts one or more complete
# known_hosts lines, separated by literal newlines. Alternatively, pre-create
# BACKUP_DATA_PATH/ssh/known_hosts.
SSH_KNOWN_HOSTS=

# Match ownership of BACKUP_DATA_PATH. For rootless Docker, use 0:0.
PUID=1000
PGID=1000
